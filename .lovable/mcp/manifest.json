{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hqmwmggvempcgzmlksaq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "gradprep-ai",
      "version": "0.1.0",
      "title": "GradPrep AI"
    },
    "tools": [
      {
        "name": "list_interview_sessions",
        "title": "List interview sessions",
        "description": "List the signed-in user's mock interview sessions, newest first, with role, difficulty, status and overall score.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "description": "How many sessions to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "status": {
              "description": "Filter by session status.",
              "type": "string",
              "enum": [
                "completed",
                "in_progress",
                "abandoned"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_interview_report",
        "title": "Get interview report",
        "description": "Get the full question-by-question report for one of the signed-in user's interview sessions: questions, the user's answers, ideal answers, scores and feedback.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The interview session id (from list_interview_sessions)."
            }
          },
          "required": [
            "session_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_progress_summary",
        "title": "Get progress summary",
        "description": "Summarize the signed-in user's interview practice progress: sessions completed, average score, best score, and recurring strengths and weaknesses.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_schedules",
        "title": "List scheduled events",
        "description": "List the signed-in user's scheduled interview practice events and reminders.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "upcoming_only": {
              "default": true,
              "description": "Only return events scheduled in the future.",
              "type": "boolean"
            },
            "limit": {
              "default": 20,
              "description": "How many events to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_schedule",
        "title": "Schedule a practice session",
        "description": "Create a scheduled interview practice session or reminder for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Short title for the event."
            },
            "scheduled_at": {
              "type": "string",
              "description": "When the event happens, as an ISO 8601 timestamp."
            },
            "description": {
              "description": "Optional details.",
              "type": "string"
            },
            "event_type": {
              "default": "practice",
              "description": "Kind of event.",
              "type": "string",
              "enum": [
                "interview",
                "practice",
                "reminder",
                "deadline"
              ]
            },
            "reminder_minutes": {
              "default": 30,
              "description": "Minutes before the event to notify.",
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            }
          },
          "required": [
            "title",
            "scheduled_at"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
